generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  REMOVED
}

enum ClassroomTeacherRole {
  OWNER
  CO_TEACHER
  ASSISTANT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  ESSAY
}

enum QuestionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  REVOKED
}

enum AssignmentTargetType {
  CLASSROOM
  STUDENT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADING
  PARTIALLY_GRADED
  GRADED
  RELEASED
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  READY
  FAILED
}

enum GenerationStatus {
  GENERATING
  GENERATED
  REVIEWING
  APPROVED
  PUBLISHED
  FAILED
  CANCELLED
}

enum AiGradeStatus {
  AI_SUGGESTED
  ACCEPTED
  REJECTED
}

model User {
  id                    String             @id @default(cuid())
  username              String             @unique
  email                 String             @unique
  passwordHash          String             @map("password_hash")
  status                UserStatus         @default(ACTIVE)
  forcePasswordChange   Boolean            @default(false) @map("force_password_change")
  failedLoginCount      Int                @default(0) @map("failed_login_count")
  lockedUntil           DateTime?          @map("locked_until") @db.Timestamptz(3)
  emailVerifiedAt       DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles                 UserRole[]
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  ownedClassrooms       Classroom[]
  classroomMemberships  ClassroomMember[]
  classroomTeaching     ClassroomTeacher[]
  createdQuestions      Question[]
  createdExams          Exam[]
  attempts              ExamAttempt[]
  individualAssignments ExamAssignment[]
  uploadedDocuments     Document[]
  aiGenerations         AiGeneration[]
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StudentProfile {
  userId      String @id @map("user_id")
  studentCode String @unique @map("student_code")
  fullName    String @map("full_name")
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("student_profiles")
}

model TeacherProfile {
  userId   String @id @map("user_id")
  fullName String @map("full_name")
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("teacher_profiles")
}

model Subject {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  archivedAt  DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  topics      Topic[]
  classrooms  Classroom[]
  questions   Question[]
  exams       Exam[]

  @@map("subjects")
}

model Topic {
  id        String     @id @default(cuid())
  subjectId String     @map("subject_id")
  name      String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  questions Question[]

  @@unique([subjectId, name])
  @@map("topics")
}

model Classroom {
  id           String             @id @default(cuid())
  ownerId      String             @map("owner_id")
  subjectId    String             @map("subject_id")
  code         String             @unique
  joinCode     String?            @unique @map("join_code")
  name         String
  description  String?
  academicYear String?            @map("academic_year")
  semester     String?
  startsAt     DateTime?          @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?          @map("ends_at") @db.Timestamptz(3)
  isActive     Boolean            @default(true) @map("is_active")
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subject      Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teachers     ClassroomTeacher[]
  members      ClassroomMember[]
  assignments  ExamAssignment[]

  @@map("classrooms")
}

model ClassroomTeacher {
  classroomId String               @map("classroom_id")
  teacherId   String               @map("teacher_id")
  role        ClassroomTeacherRole
  classroom   Classroom            @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  teacher     User                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([classroomId, teacherId])
  @@map("classroom_teachers")
}

model ClassroomMember {
  id          String       @id @default(cuid())
  classroomId String       @map("classroom_id")
  studentId   String       @map("student_id")
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(3)
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([classroomId, studentId])
  @@map("classroom_members")
}

model Question {
  id          String            @id @default(cuid())
  creatorId   String            @map("creator_id")
  subjectId   String            @map("subject_id")
  topicId     String?           @map("topic_id")
  type        QuestionType
  difficulty  Difficulty
  status      QuestionStatus    @default(DRAFT)
  content     Json
  explanation String?
  points      Decimal           @default(1) @db.Decimal(8, 2)
  source      String            @default("manual")
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator     User              @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic       Topic?            @relation(fields: [topicId], references: [id], onDelete: Restrict)
  options     QuestionOption[]
  tags        QuestionTag[]
  versions    QuestionVersion[]

  @@index([subjectId, topicId, difficulty, type])
  @@map("questions")
}

model QuestionVersion {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([questionId, version])
  @@map("question_versions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  content    String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([questionId, position])
  @@map("question_options")
}

model QuestionTag {
  questionId String   @map("question_id")
  tag        String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([questionId, tag])
  @@map("question_tags")
}

model Exam {
  id          String           @id @default(cuid())
  creatorId   String           @map("creator_id")
  subjectId   String           @map("subject_id")
  name        String
  description String?
  status      ExamStatus       @default(DRAFT)
  durationSec Int              @map("duration_sec")
  maxAttempts Int              @default(1) @map("max_attempts")
  totalPoints Decimal          @default(10) @map("total_points") @db.Decimal(8, 2)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(3)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  creator     User             @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  questions   ExamQuestion[]
  assignments ExamAssignment[]

  @@map("exams")
}

model ExamQuestion {
  id       String   @id @default(cuid())
  examId   String   @map("exam_id")
  position Int
  points   Decimal  @db.Decimal(8, 2)
  snapshot Json
  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Restrict)
  answers  Answer[]

  @@unique([examId, position])
  @@map("exam_questions")
}

model ExamAssignment {
  id          String               @id @default(cuid())
  examId      String               @map("exam_id")
  targetType  AssignmentTargetType @map("target_type")
  classroomId String?              @map("classroom_id")
  studentId   String?              @map("student_id")
  startsAt    DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime             @map("ends_at") @db.Timestamptz(3)
  maxAttempts Int                  @map("max_attempts")
  exam        Exam                 @relation(fields: [examId], references: [id], onDelete: Restrict)
  classroom   Classroom?           @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student     User?                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attempts    ExamAttempt[]

  @@map("exam_assignments")
}

model ExamAttempt {
  id           String         @id @default(cuid())
  assignmentId String         @map("assignment_id")
  userId       String         @map("user_id")
  status       AttemptStatus  @default(IN_PROGRESS)
  startedAt    DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  deadlineAt   DateTime       @map("deadline_at") @db.Timestamptz(3)
  submittedAt  DateTime?      @map("submitted_at") @db.Timestamptz(3)
  attemptOrder Json           @map("attempt_order")
  assignment   ExamAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers      Answer[]
  result       Result?

  @@index([assignmentId, userId])
  @@map("exam_attempts")
}

model Answer {
  id             String           @id @default(cuid())
  attemptId      String           @map("attempt_id")
  examQuestionId String           @map("exam_question_id")
  response       Json?
  isFlagged      Boolean          @default(false) @map("is_flagged")
  score          Decimal?         @db.Decimal(8, 2)
  savedAt        DateTime         @default(now()) @map("saved_at") @db.Timestamptz(3)
  attempt        ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  examQuestion   ExamQuestion     @relation(fields: [examQuestionId], references: [id], onDelete: Restrict)
  essayAnswer    EssayAnswer?
  aiGrade        AiGradingResult?

  @@unique([attemptId, examQuestionId])
  @@map("answers")
}

model EssayAnswer {
  answerId       String  @id @map("answer_id")
  expectedAnswer String? @map("expected_answer")
  rubric         Json?
  feedback       String?
  answer         Answer  @relation(fields: [answerId], references: [id], onDelete: Restrict)

  @@map("essay_answers")
}

model AiGradingResult {
  id         String        @id @default(cuid())
  answerId   String        @unique @map("answer_id")
  status     AiGradeStatus @default(AI_SUGGESTED)
  score      Decimal       @db.Decimal(8, 2)
  maxScore   Decimal       @map("max_score") @db.Decimal(8, 2)
  feedback   String
  criteria   Json
  reviewedBy String?       @map("reviewed_by")
  reviewedAt DateTime?     @map("reviewed_at") @db.Timestamptz(3)
  answer     Answer        @relation(fields: [answerId], references: [id], onDelete: Restrict)

  @@map("ai_grading_results")
}

model Result {
  id         String      @id @default(cuid())
  attemptId  String      @unique @map("attempt_id")
  totalScore Decimal     @map("total_score") @db.Decimal(8, 2)
  releasedAt DateTime?   @map("released_at") @db.Timestamptz(3)
  releasedBy String?     @map("released_by")
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@map("results")
}

model Document {
  id         String          @id @default(cuid())
  teacherId  String          @map("teacher_id")
  filename   String
  storageKey String          @map("storage_key")
  mimeType   String          @map("mime_type")
  sizeBytes  BigInt          @map("size_bytes")
  status     DocumentStatus  @default(UPLOADED)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  teacher    User            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  chunks     DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  position   Int
  heading    String?
  content    String
  tokenCount Int      @map("token_count")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, position])
  @@map("document_chunks")
}

model AiGeneration {
  id        String             @id @default(cuid())
  teacherId String             @map("teacher_id")
  status    GenerationStatus   @default(GENERATING)
  config    Json
  error     String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  teacher   User               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  items     AiGenerationItem[]

  @@map("ai_generations")
}

model AiGenerationItem {
  id           String         @id @default(cuid())
  generationId String         @map("generation_id")
  status       QuestionStatus @default(DRAFT)
  payload      Json
  sourceRefs   Json           @map("source_refs")
  questionId   String?        @map("question_id")
  generation   AiGeneration   @relation(fields: [generationId], references: [id], onDelete: Restrict)

  @@index([generationId])
  @@map("ai_generation_items")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  @map("actor_id")
  action      String
  subjectType String   @map("subject_type")
  subjectId   String?  @map("subject_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([subjectType, subjectId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}
