{
  "name": "ai-classroom-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "engines": { "node": ">=22.22.3 <23", "npm": ">=10" },
  "workspaces": ["packages/shared", "apps/api", "apps/web"],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate -w @classroom/api",
    "db:migrate": "npm run db:migrate -w @classroom/api",
    "db:seed": "npm run db:seed -w @classroom/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
